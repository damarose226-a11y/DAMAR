# قاعدة بيانات مستقلة خاصة بـ Dama Rose فقط
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# أنشئ المدير الرئيسي أول مرة من متغيرات البيئة فقط
OWNER_USERNAME=owner
OWNER_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# غيّرها لقيمة طويلة وعشوائية قبل النشر
SESSION_SECRET=CHANGE_ME_LONG_RANDOM_VALUE
PORT=3000

# Vercel/serverless: keep the per-function pool small
DB_POOL_MAX=1
NODE_ENV=production
